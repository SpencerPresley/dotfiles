font-family = Hack Nerd Font
# Icon-glyph fallback, consulted only for codepoints the primary font lacks.
# Inert while Hack NF is primary; it's here so a font swap or a per-machine
# override can't silently lose NF icons. Inventory: docs/fonts.md.
font-family = Symbols Nerd Font Mono
font-size = 14
theme = Banana Blueberry
cursor-style = bar
cursor-style-blink = true
cursor-click-to-move = true
cursor-opacity = 0.8
shell-integration = zsh
# Every feature listed explicitly, including ones already on by default (`title`,
# `path`): omitted features inherit the upstream default, which can move between
# releases. `ghostty +show-config --default` prints the current one.
#
# sudo: wraps sudo as `sudo --preserve-env=TERMINFO`. xterm-ghostty exists only
#   inside the app bundle, so without this, sudoers' env_reset drops TERMINFO and
#   `sudo vim`/`sudo -s` land on an unknown terminal type. Keep it on.
# ssh-env: adds `-o SetEnv COLORTERM=truecolor` and
#   `-o SendEnv TERM_PROGRAM TERM_PROGRAM_VERSION` (remote sshd must AcceptEnv them).
# ssh-terminfo: pushes `infocmp -0 -x xterm-ghostty` over the ControlMaster and
#   runs `tic -x -` remotely, so TERM stays xterm-ghostty instead of degrading to
#   xterm-256color. Needs remote tic; warns and falls back otherwise. Successes
#   are cached: `ghostty +ssh-cache` lists, `--remove=host` forces a reinstall.
#
# Both ssh features are a zsh `ssh` function, so they cover interactive ssh only
# — not scp/rsync/git-over-ssh or ssh from scripts. `command ssh <host>` bypasses
# it; needed for `idc`, whose appliance CLI chokes on the tic probe.
shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo,path
mouse-hide-while-typing = true
macos-option-as-alt = left
auto-update = check
copy-on-select = true
window-inherit-working-directory = true
window-inherit-font-size = true
keybind = shift+enter=text:\x1b\r
background-opacity = 1
background-blur = 20
desktop-notifications = true
progress-style = true
link-previews = true
# Removes the traffic lights by itself (since 1.2.0) — no titlebar-style needed.
macos-window-buttons = hidden
# macos-titlebar-style left unset (default "transparent"): `tabs` paints the
# titlebar from the terminal background, which goes see-through at opacity < 1.
window-padding-x = 10
window-padding-y = 8
scrollback-limit = 25000000


# Machine-local overrides. To change font/theme/etc on THIS machine without
# committing, put a [ghostty.local] table in .chezmoidata/ghostty-local.toml
# (gitignored); chezmoi merges it into template data and renders it inline BELOW
# at apply time, so ~/.config/ghostty/config stays the single source. Example:
#
#   [ghostty.local]
#   font-size = 17
#   theme = "Dracula"
#   font-family = ["Monaspace Neon", "Symbols Nerd Font Mono"]
#
# Scalars override (ghostty is last-value-wins). List options ($lists below)
# append rather than replace, so they get a `<key> =` reset emitted first —
# without it a font-family override lands *behind* the defaults above and never
# renders. Array and bare-scalar spellings both work, but the reset clears the
# whole list, so a font-family override must re-list Symbols Nerd Font Mono or
# you lose icon glyphs. Promote a value to the default by editing the lines above.
{{- /* Ghostty options that append rather than replace; `<key> =` clears them. */ -}}
{{- $lists := dict "font-family" true "font-family-bold" true "font-family-italic" true "font-family-bold-italic" true "keybind" true "palette" true "font-feature" true "font-variation" true "config-file" true }}
{{- $local := dig "ghostty" "local" (dict) . }}
{{- range $key, $value := $local }}
{{- if or (kindIs "slice" $value) (hasKey $lists $key) }}
{{ $key }} =
{{- end }}
{{- if kindIs "slice" $value }}
{{- range $value }}
{{ $key }} = {{ . }}
{{- end }}
{{- else }}
{{ $key }} = {{ $value }}
{{- end }}
{{- end }}
