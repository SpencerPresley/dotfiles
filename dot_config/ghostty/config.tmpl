font-family = Hack Nerd Font
# Icon-glyph fallback: only consulted for codepoints the primary font lacks.
# Hack NF is a complete Nerd Font, so this is inert today — it exists so a
# future font swap (here or via a per-machine override) can't lose NF icons.
# See docs/fonts.md in the chezmoi repo for the per-font glyph inventory.
font-family = Symbols Nerd Font Mono
font-size = 14
theme = Banana Blueberry
cursor-style = block
cursor-style-blink = true
cursor-click-to-move = true
shell-integration = zsh
# Every feature listed explicitly, including the ones already on by default
# (`title`, `path`) — omitted features inherit the upstream default, and that
# default can move between releases. `ghostty +show-config --default` prints the
# current one; on 1.3.1 it's `cursor,no-sudo,title,no-ssh-env,no-ssh-terminfo,path`.
#
# sudo: wraps sudo as `sudo --preserve-env=TERMINFO`. Ghostty sets TERMINFO to
#   the app bundle (/Applications/Ghostty.app/Contents/Resources/terminfo) and
#   xterm-ghostty exists nowhere else on this box — `env -u TERMINFO infocmp -x
#   xterm-ghostty` fails — so without this, sudoers' env_reset drops TERMINFO and
#   `sudo vim`/`sudo -s` land on an unknown terminal type. Keep it on.
# ssh-env: adds `-o SetEnv COLORTERM=truecolor` and
#   `-o SendEnv TERM_PROGRAM TERM_PROGRAM_VERSION` (remote sshd must AcceptEnv them).
# ssh-terminfo: pushes `infocmp -0 -x xterm-ghostty` through a ControlMaster
#   connection and runs `tic -x -` on the remote, so TERM stays xterm-ghostty
#   instead of degrading to xterm-256color. Needs tic on the remote; on failure
#   it warns and falls back. Successes are cached — `ghostty +ssh-cache` lists,
#   `--remove=host` forces a reinstall.
#
# Both ssh features work by defining an `ssh` zsh function, so they cover
# interactive `ssh` only — not scp/rsync/git-over-ssh or ssh from scripts.
# `command ssh <host>` bypasses the wrapper; useful for `idc`, whose custom
# appliance CLI is not a POSIX shell and will choke on the tic probe.
shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo,path
mouse-hide-while-typing = true
macos-option-as-alt = left
auto-update = check
window-padding-x = 2
window-padding-y = 2
copy-on-select = true
window-inherit-working-directory = true
window-inherit-font-size = true
keybind = shift+enter=text:\x1b\r
background-opacity = 1
background-blur = 20
desktop-notifications = true
progress-style = true
link-previews = true

# Machine-local overrides. To change font/theme/etc on THIS machine without
# committing, create .chezmoidata/ghostty-local.toml (gitignored — see the repo
# .gitignore) with a [ghostty.local] table. chezmoi merges it into template data
# and renders the values inline BELOW at apply time; nothing is placed on the
# machine, and ~/.config/ghostty/config stays the single source. Example:
#
#   [ghostty.local]
#   font-size = 17
#   theme = "Dracula"
#   font-family = ["Monaspace Neon", "Symbols Nerd Font Mono"]
#
# Scalars override (ghostty last-value-wins). List values (font-family, keybind,
# palette, …) emit a reset line first, because ghostty appends to list options
# rather than replacing — so a font-family override must re-list Symbols Nerd
# Font Mono or you lose icon glyphs. Promote a value to the tracked default by
# editing the plain lines above and committing.
{{- $local := dig "ghostty" "local" (dict) . }}
{{- range $key, $value := $local }}
{{- if kindIs "slice" $value }}
{{ $key }} =
{{- range $value }}
{{ $key }} = {{ . }}
{{- end }}
{{- else }}
{{ $key }} = {{ $value }}
{{- end }}
{{- end }}
