# Clay Dusk — the in-between: Clay's hues on a warm charcoal, not near-black.
# Opt in per machine via .chezmoidata/ghostty-local.toml:  theme = "Clay Dusk"
#
# Foreground is cream (#E0DBCD, 11.2:1), not white, and every palette text
# colour clears 4.7:1 so minimum-contrast never swaps in pure #FFFFFF.

background = #262420
foreground = #E0DBCD
cursor-color = #D97757
cursor-text = #262420
selection-background = #45413A
selection-foreground = #F0ECE2

palette = 0=#34312B
palette = 1=#E07A5A
palette = 2=#9DB580
palette = 3=#D9A048
palette = 4=#82AEDB
palette = 5=#B595D8
palette = 6=#6BB8B3
