# --- ATLASCYBER reverse-proxy bastion (GovCloud us-gov-east-1) ---
# Jump host for the prod backend. Public IP lives in 1Password.
Host atlascyber-reverse-proxy
  HostName {{ onepasswordRead "op://Personal/atlascyber-reverse-proxy-ip/credential" }}
  User ec2-user
  IdentityFile ~/.ssh/id_ed25519.pub
  IdentitiesOnly yes

# --- ATLASCYBER prod backend "beast", via the reverse-proxy bastion ---
# beast has no public SSH; a reverse tunnel exposes it on the bastion's
# localhost:22000 (see docs/deployment/JENKINS.md §3). Key auth works
# end-to-end via the 1Password agent; the "atlascyberbeast-pw" 1Password
# item is only a password fallback. Use `ssh -A atlascyber-backend` for
# on-box git ops so your forwarded agent auths to GitHub.
# HostKeyAlias gives beast a stable known_hosts identity so the tunneled
# localhost:22000 doesn't collide with other localhost-forwarded hosts.
Host atlascyber-backend
  HostName localhost
  Port 22000
  User atlascyber
  ProxyJump atlascyber-reverse-proxy
  IdentityFile ~/.ssh/id_ed25519.pub
  IdentitiesOnly yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  HostKeyAlias beast-reverse-tunnel
  StrictHostKeyChecking accept-new

# --- NEUCIC reverse proxy (public bastion for neucic-api.crunchatlas.ai) ---
# GovCloud EC2 i-0d74668f6786f666e, Amazon Linux 2023. Public IP is not a
# secret (EC2 public IPv4), so it's inline rather than in 1Password. Sibling
# of atlascyber-reverse-proxy; carries the NEUCIC backend's reverse tunnels.
Host neucic-reverse-proxy
  HostName 182.30.168.128
  User ec2-user
  IdentityFile ~/.ssh/id_ed25519.pub
  IdentitiesOnly yes

# --- NEUCIC prod backend "CrunchDev", via the NEUCIC reverse proxy ---
# CrunchDev has no public SSH: its public IP (64.223.131.115) is the site's
# Ubiquiti edge router, not the box. A reverse tunnel exposes it on the
# bastion's localhost:22000, so this entry only works while that tunnel is
# up — when it wedges there is NO remote path in (tracker issue
# deploy-tunnel-hardening/02).
# HostKeyAlias is REQUIRED, not cosmetic: atlascyber-backend also lands on
# localhost:22000, and known_hosts still carries beast's keys under the bare
# [localhost]:22000 name. Without the alias, ssh compares CrunchDev's host key
# against beast's and hard-fails with REMOTE HOST IDENTIFICATION HAS CHANGED.
# Key auth since 2026-08-24 (id_ed25519.pub appended to viejo's
# authorized_keys). Password fallback still works if the key entry is ever
# lost: $NEUCIC_VIEJO_PW (op://Personal/neucic-viejo/password, exported by
# dot_zshenv.tmpl). ControlMaster kept as a convenience — one TCP/proxy
# chain per 10 min instead of per command.
Host neucic-backend
  HostName localhost
  Port 22000
  User viejo
  ProxyJump neucic-reverse-proxy
  HostKeyAlias neucic-reverse-tunnel
  StrictHostKeyChecking accept-new
  IdentityFile ~/.ssh/id_ed25519.pub
  IdentitiesOnly yes
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m
  ServerAliveInterval 60
  ServerAliveCountMax 3

# BACKUP admin path: the same box over the supervised ssh_tunnel_22001 (its own
# supervisor file, so a `supervisorctl update` that restarts 22000 leaves this
# one up — proven 2026-09-10 when the first host install left 22000 stopped and
# this was the way back in). Same key, same jump, same HostKeyAlias (it IS the
# same host key). Rides the same Wi-Fi uplink, so it is tunnel redundancy, not
# out-of-band access (tracker deploy-tunnel-hardening/06, /13).
Host neucic-backend-backup
  HostName localhost
  Port 22001
  User viejo
  ProxyJump neucic-reverse-proxy
  HostKeyAlias neucic-reverse-tunnel
  StrictHostKeyChecking accept-new
  IdentityFile ~/.ssh/id_ed25519.pub
  IdentitiesOnly yes
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m
  ServerAliveInterval 60
  ServerAliveCountMax 3

# --- gw bastion (GovCloud reverse proxy, sibling of the two above) ---
# Terraform-built template box awaiting product assignment. EC2 public IPv4
